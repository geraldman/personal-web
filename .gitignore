# Root-level ignores for the monorepo.
# Each app keeps its own .gitignore for app-specific paths (see apps/web/.gitignore).

# dependencies
node_modules/
.pnp
.pnp.*

# build output
.next/
out/
build/

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
