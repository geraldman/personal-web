# dashboard.geraldmanurung.site
# Copy to .env in this directory and fill in. Never commit .env.

# --- Next.js app (also add these to the dashboard Vercel project) ---------------------------

# Supabase → Project Settings → API Keys → "Legacy API keys" tab.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses RLS. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Numeric GitHub user id of the only account allowed to sign in.
# Find it at https://api.github.com/users/<your-github-username> → "id".
DASHBOARD_OWNER_GITHUB_ID=

# Base URL used for the OAuth redirect. Local: http://localhost:<dev port>.
# Production: https://dashboard.geraldmanurung.site
NEXT_PUBLIC_SITE_URL=http://localhost

# --- Edge Function secrets (pushed with `supabase secrets set --env-file`; not for Vercel) ----

# Google AI Studio → Get API key.
GEMINI_API_KEY=
LLM_PROVIDER=gemini

# --- Supabase CLI, local only (applying migrations + generating types; not for Vercel) -------

# The <ref> in https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
# The database password set when the project was created.
SUPABASE_DB_PASSWORD=
# supabase.com/dashboard/account/tokens → Generate new token.
SUPABASE_ACCESS_TOKEN=
